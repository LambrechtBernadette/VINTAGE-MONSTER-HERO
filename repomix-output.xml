export default function template(monster) {
  const types = ["Giant reptile", "Alien", "Mutant", "Giant insect", "Robot", "Deep-sea creature"];

  return `
    <tr class="monster-row" data-id="${monster.id}">
      <td class="p-3 font-semibold">
        <span class="display-name isEditing-hidden">${monster.name}</span>
        <input type="text" class="input-name isEditing-visible field" value="${monster.name}" />
      </td>
      <td class="p-3">
        <span class="display-type isEditing-hidden">${monster.type}</span>
        <select class="input-type isEditing-visible field">
          ${types.map(t => `<option ${t === monster.type ? "selected" : ""}>${t}</option>`).join("")}
        </select>
      </td>
      <td class="p-3 whitespace-nowrap">
        <span class="display-danger isEditing-hidden" title="Danger level ${monster.dangerLevel}">${"☠️".repeat(monster.dangerLevel)}</span>
        <input type="number" min="1" max="5" class="input-danger isEditing-visible field" value="${monster.dangerLevel}" />
      </td>
      <td class="p-3">
        <span class="display-year isEditing-hidden">${monster.year}</span>
        <input type="number" min="1950" max="1969" class="input-year isEditing-visible field" value="${monster.year}" />
      </td>
      <td class="p-3">
        <div class="flex justify-end gap-2">
          <button class="btn-check isEditing-visible btn btn-jade py-2 px-3" aria-label="Save">
            <i class="fa-solid fa-check"></i>
          </button>
          <button class="btn-edit isEditing-hidden btn btn-gold py-2 px-3" aria-label="Edit">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button class="btn-delete isEditing-hidden btn btn-lipstick py-2 px-3" aria-label="Delete">
            <i class="fa-solid fa-skull"></i>
          </button>
        </div>
      </td>
    </tr>
  `;
}
/*<!-- t vient directement des éléments du tableau types. un par un, injecté automatiquement par .map() à chaque itération affichage/édition, mais pour l'édition c'est un <select>. La ligne types.map(...) génère dynamiquement une <option> par type possible, et ajoute selected sur celle qui correspond au type actuel du monstre — c'est un template literal imbriqué dans un autre. -->*/


/*Une seule <tr> contient en permanence les deux versions (texte statique + champ de formulaire) pour chaque donnée. Il n'y a pas de re-génération du HTML au clic sur "Edit" : on bascule juste une classe CSS (isEditing) sur la ligne entière, ce qui montre/cache les bons éléments via CSS. C'est une technique simple pour éviter de reconstruire le DOM à chaque changement de mode.*/
</file>

<file path="src/components/monsterList/DB.js">
export default class DB {

static setApiURL(data){
    this.apiURL = data;
}


    static async findAll(){
        const response = await fetch(this.apiURL + "monsters");
        return response.json();
    }

    // Crée un nouveau monstre dans la base de données
    static async create(monster){
        const response = await fetch(this.apiURL + "monsters", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify(monster),
        });
        return response.json();
    }

    // Met à jour un monstre existant dans la base de données
    static async updateOne(monster){
        const response = await fetch(this.apiURL + "monsters/" + monster.id, {
            method: "PUT",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify(monster),
        });
        return response.json();
    }

    // Supprime un monstre existant dans la base de données
    static async deleteOne(id){
        const response = await fetch(this.apiURL + "monsters/" + id, {
            method: "DELETE"
        });
        return response.json();
    }
}
